# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CHEAP_MODEL=claude-haiku-5-5
STRONG_MODEL=claude-opus-5-5
ROUTING_ENABLED=true
CHUNKING_STRATEGY=headings

ASSISTANT_NAME=Rocco
# Person who receives escalations; leave empty to say "the family"
OWNER_NAME=

# Production: hide internals from the browser and allow only the site's domain
EXPOSE_INTERNALS=true
ALLOWED_ORIGINS=

# Escalation emails (SMTP). Port 465 = SSL, 587 = STARTTLS.
# Aruba: smtps.aruba.it, 465, full mailbox address as user. Gmail: smtp.gmail.com, 465, app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ESCALATION_EMAIL_TO=

# Real site: availability from Slope's iCal calendars (one per apartment, never commit the URLs),
# no prices (dynamic), and the real knowledge base folder (required in slope mode).
AVAILABILITY_SOURCE=demo
BOOKING_URL=
KB_DIR=
# real site: KB_DIR=data/real/kb and RETRIEVAL_K=6 (short chunks, multi-question messages)
# CASA_ICAL_CAPANNA=
# CASA_ICAL_GIRASOLE=
